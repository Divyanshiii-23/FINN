# --- Data mode -------------------------------------------------------------
# auto (default): live sources first (Yahoo EOD, BSE announcements, screener.in),
#                 each falling back to the recorded snapshot independently.
# snapshot:       never touch the network (demo / offline).
# live:           live only, no fallback (for debugging adapters).
FINN_DATA_MODE=auto

# --- LLM (optional) --------------------------------------------------------
# Without a key FINN still works: every number is computed in code, and the demo research set
# ships with curated primary-source evidence. A key enables live transcript extraction for ANY
# ticker, LLM-written bull/bear and Ask FINN synthesis. First key found wins:
GEMINI_API_KEY=            # free tier: https://aistudio.google.com/apikey
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional model overrides (defaults: gemini-3.5-flash-lite for extraction, gemini-3.8-flash for synthesis)
# FINN_MODEL_FAST=
# FINN_MODEL_REASONING=
